# === Stock AI Trader — environment configuration ===

# Database (defaults to local SQLite file; swap for a Postgres URL in production,
# e.g. postgresql+psycopg2://user:pass@localhost:5432/stock_ai_trader)
DATABASE_URL=sqlite:///./data/app.db

# Market data
DEFAULT_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,TSLA
DEFAULT_INTERVAL=1d
HISTORY_PERIOD=2y
USE_SYNTHETIC_DATA_ON_FAILURE=true

# === LLM Providers (tries in order: OpenRouter → Gemini → Anthropic → Ollama → Template) ===
# Only ONE key is needed. System works fully without any key (uses templates).

# OpenRouter (aggregates top AI models with unified OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_NAME=AI Investment Intelligence
OPENROUTER_SITE_URL=https://stock-ai-trader.local

# Google Gemini (free tier: 15 RPM, recommended for free usage)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Local Ollama (no key needed, just install & run Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Live News (optional — falls back to Google News RSS then synthetic) ===
# Finnhub (free tier: 60 calls/min, get key at https://finnhub.io)
FINNHUB_API_KEY=

# Risk engine defaults
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_VOLATILITY=0.35
MAX_DAILY_LOSS_PCT=0.03
VAR_CONFIDENCE=0.95
STOP_LOSS_PCT=0.08

# Paper trading
STARTING_CASH=100000
TRANSACTION_COST_BPS=5
SLIPPAGE_BPS=3

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# Logging
LOG_LEVEL=INFO
